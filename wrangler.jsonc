{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvxu-ai-travel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "AUTH_FAILURE_LIMIT",
      "namespace_id": "1002",
      // Workers rate-limit periods can only be 10 or 60 seconds.
      // 10 failures / 60 seconds per IP is the closest binding to 10 / 10 minutes.
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_DEV_BYPASS": "",
    "AUTH_MODE": "owner-key",
    "TEAM_DOMAIN": "",
    "POLICY_AUD": "",
  },
  "secrets": {
    "required": ["ACCESS_ALLOWED_EMAIL"],
  },
}
