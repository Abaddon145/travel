# Same policy as shared/security-headers.ts. Applied to static assets only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://webapi.amap.com 'unsafe-eval'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://webapi.amap.com https://*.amap.com https://*.is.autonavi.com; connect-src 'self' https://webapi.amap.com https://restapi.amap.com https://*.amap.com https://*.is.autonavi.com; worker-src 'self' blob:; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-XSS-Protection: 0
  X-Robots-Tag: noindex
